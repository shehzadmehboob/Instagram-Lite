<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Edit Profile - Instagram-Lite</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <nav class="navbar">
        <div class="navbar-inner">
            <a href="/" class="logo">Instagram-Lite</a>
            <div class="nav-links">
                <a href="/">Feed</a>
                <a href="/profile/<%= user.username %>">My Profile</a>
                <a href="/logout">Logout</a>
            </div>
        </div>
    </nav>

    <main class="container">
        <div class="form-page" style="max-width: 500px;">
            <a href="/profile/<%= user.username %>" class="back-link">← Back to Profile</a>
            <h1>Edit Profile</h1>

            <form action="/profile/edit" method="POST" enctype="multipart/form-data" class="note-form">
                <div class="form-group">
                    <label for="avatar">Profile Picture</label>
                    <input type="file" id="avatar" name="avatar" accept="image/*">
                </div>

                <div class="form-group">
                    <label for="bio">Bio</label>
                    <textarea id="bio" name="bio" style="min-height: 120px;"><%= user.bio || '' %></textarea>
                </div>

                <div class="form-group" style="flex-direction: row; align-items: center; gap: 10px;">
                    <input type="checkbox" id="is_private" name="is_private" style="width: auto;" <%=user.is_private
                        ? 'checked' : '' %>>
                    <label for="is_private">Private Account (Require approval for new followers)</label>
                </div>

                <div class="form-actions">
                    <a href="/profile/<%= user.username %>" class="cancel-btn">Cancel</a>
                    <button type="submit" class="submit-btn">Save Profile</button>
                </div>
            </form>
        </div>
    </main>
</body>

</html>